# Copiá este archivo como .env.local y completá los valores. .env.local NO se sube a git.

# Supabase → Project Settings → API (o Data API)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave pública: anon (o "publishable"). Puede ir en la página.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta: service_role (o "secret"). Solo servidor. Nunca la compartas ni la pegues en el chat.
SUPABASE_SERVICE_ROLE_KEY=

# Dirección del sitio (en local: http://localhost:3002 · en Vercel: el dominio final)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Brevo → SMTP & API → API Keys (para los avisos de aprobación, rechazo y suspensión)
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Agenda de Móviles
